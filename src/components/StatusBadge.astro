---
import { statusLabels, type Project } from '../data/projects';

interface Props {
  status: Project['data']['status'];
}
const { status } = Astro.props;
---

<span class:list={['badge', 'mono', `is-${status}`]}>{statusLabels[status]}</span>

<style>
  .badge {
    font-size: 12px;
    padding: 3px 8px;
    border-radius: 999px;
    background: #fbead0;
    color: #6b3d00;
    white-space: nowrap;
  }
  .is-live { background: #dcefe2; color: #1d5a33; }
  .is-building, .is-coming-soon { background: #e1e9f6; color: #24477a; }
  .is-paused, .is-archived { background: #ebe7e0; color: var(--muted); }
</style>

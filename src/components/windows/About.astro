---
import { about, site, socials } from '../../data/site';
---

<div class="about">
  <div class="stack-6">
    <h1>{site.name}</h1>
    <p class="mono muted">{site.tagline}</p>
  </div>
  <ul class="focus" aria-label="Focus areas">
    {about.focus.map((f) => <li class="mono">{f}</li>)}
  </ul>
  {about.paragraphs.map((text) => <p>{text}</p>)}
  <div class="links">
    {socials.map((s) => <a href={s.href}>{s.label}</a>)}
  </div>
</div>

<style>
  .about {
    padding: 28px 32px 32px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    font-size: 16px;
    line-height: 1.6;
  }
  .stack-6 { display: flex; flex-direction: column; gap: 6px; }
  h1 { margin: 0; font-size: 30px; line-height: 1.15; font-weight: 600; letter-spacing: -0.5px; }
  p { margin: 0; }
  .mono { font-size: 13px; line-height: 1.4; }
  .focus { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .focus li {
    font-size: 12px;
    line-height: 1.4;
    padding: 3px 8px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: #fff;
    color: var(--muted);
  }
  .links { display: flex; flex-wrap: wrap; gap: 16px; font-size: 15px; padding-top: 4px; }
</style>

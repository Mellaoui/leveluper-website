---
import { posts } from '../../data/site';
---

<div class="list">
  {posts.length > 0 ? (
    posts.map((post) => (
      <a href={post.href} class="card-link post">
        <span class="title">{post.title}</span>
        <span class="mono muted meta">{post.date} · {post.tag}</span>
      </a>
    ))
  ) : (
    <p class="empty muted">No posts yet.</p>
  )}
</div>

<style>
  .list { display: flex; flex-direction: column; }
  .post {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 24px;
    border-bottom: 1px solid var(--line-soft);
    color: var(--ink);
    text-decoration: none;
  }
  .post:hover { color: var(--ink); }
  .title { font-size: 16px; font-weight: 600; }
  .meta { font-size: 12px; }
  .empty { margin: 0; padding: 24px; font-size: 15px; }
</style>

---
interface Props {
  name: 'close';
  size?: number;
}
const { name, size = 24 } = Astro.props;
---

<svg
  aria-hidden="true"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {name === 'close' && <path d="M6 6l12 12M18 6L6 18" />}
</svg>

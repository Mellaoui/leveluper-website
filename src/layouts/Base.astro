---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  jsonLd?: object[]; // schema.org nodes, combined into one @graph
  markdown?: string; // path of this page's Markdown twin, for agents
}
const {
  title = `${site.brand} — ${site.name}`,
  description = site.description,
  jsonLd = [],
  markdown,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ld = jsonLd.length ? JSON.stringify({ '@context': 'https://schema.org', '@graph': jsonLd }) : null;
---

<!doctype html>
<html lang="en" style={`--wallpaper:${site.wallpaper};--accent:${site.accent}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content={site.wallpaper} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} />}
    <link rel="alternate" type="application/json" title="Projects" href="/projects.json" />
    <link rel="help" type="text/plain" title="llms.txt" href="/llms.txt" />
    {ld && <script type="application/ld+json" set:html={ld} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
    />
  </head>
  <body>
    <slot />
  </body>
</html>

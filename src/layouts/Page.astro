---
// Plain document page (project index, project detail): one paper window
// on the wallpaper, readable without JavaScript.
import Base from './Base.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  path: string; // shown in the title bar, e.g. ~/projects/verifeye
  jsonLd?: object[];
  markdown?: string;
}
const { title, description, path, jsonLd, markdown } = Astro.props;
---

<Base title={`${title} — ${site.brand}`} description={description} jsonLd={jsonLd} markdown={markdown}>
  <div class="page">
    <nav class="crumbs mono" aria-label="Breadcrumb">
      <a href="/">{site.domain}</a>
      <slot name="crumbs" />
    </nav>
    <article class="doc">
      <header class="doc-bar"><span class="mono">{path}</span></header>
      <div class="doc-body">
        <slot />
      </div>
    </article>
    <footer class="page-foot mono">
      For agents: <a href="/llms.txt">llms.txt</a> · <a href="/projects.json">projects.json</a>
      {markdown && <> · <a href={markdown}>this page as Markdown</a></>}
    </footer>
  </div>
</Base>

<style>
  .page {
    min-height: 100vh;
    padding: 32px 16px 48px;
    font-family: var(--font-sans);
    color: var(--ink);
    background-color: var(--wallpaper);
    background-image: radial-gradient(var(--dot) 1px, transparent 1px);
    background-size: 24px 24px;
  }
  .crumbs, .doc, .page-foot { max-width: 760px; margin: 0 auto; }
  .crumbs { display: flex; flex-wrap: wrap; gap: 6px; font-size: 13px; color: #a9b8c7; margin-bottom: 14px; }
  .crumbs a, .page-foot a { color: var(--on-night); }
  .crumbs a:hover, .page-foot a:hover { color: var(--accent); }
  .doc {
    background: var(--paper);
    border: 1px solid var(--night);
    border-radius: 10px;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.35);
    overflow: hidden;
  }
  .doc-bar {
    height: 44px;
    display: flex;
    align-items: center;
    padding: 0 16px;
    background: var(--bar-front);
    border-bottom: 1px solid var(--line);
    font-size: 13px;
    font-weight: 500;
  }
  .doc-body { padding: 28px 32px 32px; font-size: 16px; line-height: 1.6; }
  .page-foot { margin-top: 16px; font-size: 12px; color: #a9b8c7; }
  @media (max-width: 560px) {
    .doc-body { padding: 22px 20px 26px; }
  }
</style>
